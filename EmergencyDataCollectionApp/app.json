{
  "expo": {
    "_comment": "Note: iOS and Android use different bundle identifiers due to separate developer accounts",
    "name": "EmergencyDataCollectionApp",
    "slug": "EmergencyDataCollectionApp",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/appicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to take photos for emergency reports.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save photos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.shunt161.EmergencyDataCollectionApp",
      "buildNumber": "9"
    },
    "android": {
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "package": "com.davidhanley26.EmergencyDataCollectionApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) accesses your storage to upload photos.",
          "cameraPermission": "The app needs access to your camera to let you take photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "13.0",
            "otherCPlusPlusFlags": "-D_FMT_CHAR8_T=0",
            "buildSettings": {
              "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64 x86_64",
              "GCC_PREPROCESSOR_DEFINITIONS": "TARGET_OS_SIMULATOR=0"
            }
          },
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "33.0.0",
            "minSdkVersion": 21,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]      
    ],
    "extra": {
      "eas": {
        "projectId": "1a9a31a9-45ad-44e7-987d-c853997aebc5"
      }
    },
    "hooks": {
      "postPublish": [
        {
          "file": "fix-simulator-issue.js"
        }
      ]
    }
  }
}
